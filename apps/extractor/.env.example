# --- Redis / Valkey ---
REDIS_URL="redis://localhost:6379"

# --- Database ---
DATABASE_URL="postgres://whimsync:whimsync_dev_pass@localhost:5432/whimsync"

# --- MinIO Cold Storage ---
MINIO_ENDPOINT="localhost"
MINIO_PORT=9000
MINIO_ACCESS_KEY="whimsync"
MINIO_SECRET_KEY="whimsync_dev_pass"
MINIO_BUCKET="whimsync-cold"
MINIO_USE_SSL="false"
MINIO_REGION="us-east-1"

# --- Google Gemini VLM ---
GEMINI_API_KEY="your_gemini_api_key_here"
GEMINI_MODEL="gemini-2.5-flash"
VLM_CONCURRENCY=3
VLM_DELAY_SECONDS=0.5
VLM_MAX_RETRIES=3

# --- Office Document Conversion ---
LIBREOFFICE_PATH="soffice"

# --- BullMQ Queue Names ---
DOCUMENT_PARSING_QUEUE="document-parsing"
CHUNKING_QUEUE="chunking"
