# --- API Server (`apps/api`) ---
PORT=3001
NODE_ENV=development
CORS_ORIGINS="http://localhost:3000"

# --- Clerk Authentication Keys (Get these from https://dashboard.clerk.com -> API Keys) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_your_clerk_publishable_key"
CLERK_PUBLISHABLE_KEY="pk_test_your_clerk_publishable_key"
CLERK_SECRET_KEY="sk_test_your_clerk_secret_key"

# --- Database & Queue (`packages/db`, `apps/api`, `apps/worker`) ---
DATABASE_URL="postgres://whimsync:whimsync_dev_pass@localhost:5432/whimsync"
DB_MAX_CONNECTIONS=10
REDIS_URL="redis://localhost:6379"

# --- MinIO Cold Storage (`packages/core`, `apps/worker`, `apps/extractor`) ---
MINIO_ENDPOINT="localhost"
MINIO_PORT=9000
MINIO_ACCESS_KEY="whimsync"
MINIO_SECRET_KEY="whimsync_dev_pass"
MINIO_BUCKET="whimsync-cold"
MINIO_USE_SSL="false"

# --- Optional S3 Compatibility Aliases (AWS S3 / Cloudflare R2) ---
S3_ENDPOINT="http://localhost:9000"
S3_ACCESS_KEY_ID="whimsync"
S3_SECRET_ACCESS_KEY="whimsync_dev_pass"
S3_BUCKET_NAME="whimsync-cold"
S3_FORCE_PATH_STYLE="true"

# --- Worker & LLM Extraction (`apps/worker`, `apps/extractor`) ---
GEMINI_API_KEY="your_gemini_api_key_here"
LLM_MODEL="gemini-3.5-flash-lite"
EMBEDDING_MODEL="gemini-embedding-2"
